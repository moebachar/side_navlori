<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wifi_scanner</name>
  <version>0.1.0</version>
  <description>Publishes raw WiFi scans (sudo iw dev wlan0 scan) as JSON on /wifi/rssi</description>
  <maintainer email="navlori@localhost">navlori</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
