# side_navlori is the sandbox. Data lives in the vault X:/navlori-data (git + DVC):
#   data/             -> link to X:/navlori-data/robot   (golden runs, run1..8, calib, floor plan)
#   dataset_pipeline/ -> link to X:/navlori-fusion/scripts/dataset (ground-truth pipeline code)
/data
/dataset_pipeline

# Slide material: only the prompts are versioned; images/videos are in the OneDrive snapshot
slides_progress/**
!slides_progress/
!slides_progress/PROMPTS.md

# Raw recordings / packaging leftovers (belong in the vault)
*.db3
*.bag
*.zip
*.MOV

# Python / notebook junk
__pycache__/
*.pyc
.ipynb_checkpoints/

.claude/settings.local.json

# Radio Flow SLAM report: generated by dpro/rf/report/build.py from export_report output
dpro/rf/report/index.html
dpro/rf/report/report_data.json
